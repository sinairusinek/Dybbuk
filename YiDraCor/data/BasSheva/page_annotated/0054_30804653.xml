                <TextEquiv>
                    <Unicode>הם... הם... נוּ, ווִי אַזוי זאָל מִיר דִי גאל נִיט צערשפּרינגען וֶוערֶען?</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="TextRegion_1648848665520_1925l5" custom="readingOrder {index:4;}">
