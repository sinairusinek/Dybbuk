                <TextEquiv>
                    <Unicode>צדוק: אַזוי, אַזוֹי, אִיז אַרויס דֶער סוד פוּן עזרִיה'ס פּלוּצימדיגען רייכטהוּם!</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="TextRegion_1648848665520_1925l4" custom="readingOrder {index:3;}">
