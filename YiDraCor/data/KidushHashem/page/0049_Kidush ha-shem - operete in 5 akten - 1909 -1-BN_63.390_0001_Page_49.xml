אבארבאנעל: אַ צַאהלְרֵייכֶע הָעָרְדָע הָאט נָאט אַ הִירֶט צוּר אִיבָּעֶר-
וְוַאכוּנְג גֶעֶגֶעבָּעֶן. אַלֶם לָאהֶן פַאר זַיַּין מִיה הָאט עֶר אֵיהָם עֶרְלוֹיִבְּט,
עֶר זָאל זִיךְ נֶעֶהְרֶען פוּן דָער סְטַאדָעיס מִילָךְ אוּן וָאל זִיךְ קְלֵידֶעֶן
פוּן אֵיהֶר וְוָאל. פְּלֶעִצְלִיךְ הָאט דָעַר הִירְט אֵין אֵיין אִיבְּלָעֶר לוֹיְגָע דִי
אוּנְשוּלְדִיגָע טְהִירָע פוּן זְייעֶר שְׁטַאל אַרוֹיס-געִיָאנְט, שׁוּצְלָאז וַוַאנְדָעָרֶן
זְיֵי אֵיצט אַרוּם אֵין פְרַיִיעֶן אוּן מוּזָעֶן פָאר הוּנְגֶעַר אוּמְקוּמָען... איךְ
בֶּעט אֵיבֶּערְדָעם גֶערֶעכְטִינְקֵייט גָעֶנְעָן דִיעזְעֶן הירֶט!...
קעניג: דוּ רֶעדסט רֶעטְהזֶעלְהַאפְט! וְוָעֶר אִיז דִיעזֶער הִירֶט?
אַבארבאנעַל: דָעַר הִירֶט בִּיזְטוּ, מַיין קענִיג! גָאט הָאט אַ גְרוֹיסֶען טֵייל
פוּן זַיין הָעָרְדָע אוּנְטָער דַיִין שוּץ אַנְפֶעַרְטְרוֹיְעֶט. דְרַיִי מָאל הוּנְדָערֶט
טוֹיזֶענד יוּדִישע אוּנְטָערְטַאנָען בֶּעצְאהְלָען דִיר פִּינִקְטְלִיךְ דֻעם לָאהֶן
פאר דיין פִירְזָארְגע, אוּן וויפיל טויזענְדער פוּן יוּדישע לֶעֶבָּען זֶענֶען
שוין אויף דָעם שלַאכטְפֶעלד געֶבְּלִיבֵּען אַלס אָפְּפֶער פַארֶץ פַאטֶער-
לַאנְד? עֶרְקוּנְדִיג דִיךְ, וְוִיפִיל יוּדָען עֶם זֶעֶנָען שׁוֹיִן זְיֵיט יָאהְרָען וְוָעגָען
מָארד אָדער דִיעבִּשְטַאהל פֶערְאוּרְטֵיילְט גָעווָארֶען? וְוִיפִיל יוּדֶען
זעהט מען זִיךְ ווַאלְגערֶן בֶּעִטְרוּנְקָען אֵין דִי נַאסֶען... אַצינד ווִילְסְטוּ
פְּלוּצִים דְרַיִי מָאל הוּנְדָערְט טוֹיזֶעֶנְד פְלֵייסִיגָע עֶהִרְלִיכֶע אוּן שׁוּלְדְלָאזָע
בִּירְגֶער מיט איין אֵיינְצינען פֶעדֶערצוּג פוּן דַיין לַאנד פֶערְיָאנָען, וואוּ
בְּלַיִיבּט דַיִין גֶעֶרְעכְטִינְקֵייט, מַיִין קֶעָנִיג?!
לאראש: איך בֶּעט מיין קֶענִיג אוּם עֶרְלויבְּנִים! ווען גאט האט אוּנזער
קָעֲנִיג צוּם הִירֶט אִיבָּער דִי הָעַרְדָע פוּן דְרַיִי מָאל הוּנְדָעָרְט טוֹיזֶעֶנְד
יוּדִישע אוּנְטֶערטַאנען בֶּעֶשְטִימְט, דַאן הָאט דער הִירֶט אַ רֶעכט, זַיִין
הערְדע דעם רעכטען וועג צו ווייזען. די יודישע אונטערטאנען
געפינען זיך מיט זייער גלויבּען אויף אַ פאלשען וועג. ווילט איהר
וַוַיִיטָעַר אֵין אוּנְזָעַר לַאנְד בְּלַיִיבָּעַן, דַאן בֶּעֶקָעהֶרֶט אַייךְ צוּ אוּנְזָעֶר
גְלוֹיבָּען! ווֵייגֶערט איהר אַייךְ, דַאן געהט אוּן זוּכטיס אַייךְ אַיין
אַנְדְעֶרֶן הִירֶט.
אַבארבאנעל: עֶרְלוֹיבּ מִיר אֵיין פְרַאגָע!</Unicode>
