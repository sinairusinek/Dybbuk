                <Baseline points="397,2312 462,2314 528,2315 593,2316 659,2317 725,2317 790,2318 856,2318 921,2318 987,2318 1053,2318 1118,2317 1184,2318 1249,2318 1315,2318 1380,2319 1446,2320 1512,2321 1577,2322 1643,2324 1709,2327"/>
                <TextEquiv>
                    <Unicode>איזאבעלא: פָאטֶער! בּיים אלְמֶעכטִיגֶען גָאט בֶּעשׁווער אִיך דִיך, דוּ</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="r1l34" custom="readingOrder {index:28;}">
